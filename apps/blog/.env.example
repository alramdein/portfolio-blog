# Supabase → Connect → Transaction pooler (port 6543)
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Random string used to anonymise visitor IPs for unique-view counting. Generate: openssl rand -hex 32
VIEW_HASH_SALT=

NEXT_PUBLIC_SITE_URL=https://blog.aliframdani.com
NEXT_PUBLIC_TIMEZONE=Asia/Jakarta
