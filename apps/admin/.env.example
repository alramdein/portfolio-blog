# Same database as the blog app (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Login. Generate the hash with: npm run hash-password  (never put the plain password here)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Signs the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=

# Image uploads → Supabase Storage. Settings → API. The service role key is secret: server-only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=blog-images

NEXT_PUBLIC_BLOG_URL=https://blog.aliframdani.com
NEXT_PUBLIC_TIMEZONE=Asia/Jakarta
