# Supabase → Connect → Transaction pooler (port 6543). SUPABASE_URL / SUPABASE_SECRET_KEY are set by the Vercel Supabase integration (no prefix).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Login. Generate the hash with: npm run hash-password  (never put the plain password here)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Signs the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=

SUPABASE_STORAGE_BUCKET=blog-images
NEXT_PUBLIC_BLOG_URL=https://blog.aliframdani.com
NEXT_PUBLIC_TIMEZONE=Asia/Jakarta
